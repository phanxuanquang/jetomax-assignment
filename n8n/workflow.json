    {
      "parameters": {
        "jsCode": "const threadSummaries = $json.threadSummaries || [];\nconst overallSummary = $json.overallSummary || '';\nconst publishedAt = new Date().toISOString();\n\nconst lines = threadSummaries.map(t =>\n  `- ${t.displayName} (${t.conversationId}): ${t.summary}`\n).join('\\n');\nconst digestText = `Daily digest — ${publishedAt}\\n\\nOverall (last 24h):\\n${overallSummary}\\n\\nPer-conversation summaries:\\n${lines || '(no active conversations)'}`;\n\nconst escapeHtml = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rowsHtml = threadSummaries.map(t => `\n  <li><strong>${escapeHtml(t.displayName)}</strong> (${escapeHtml(t.conversationId)})<br>${escapeHtml(t.summary)}</li>`\n).join('');\nconst digestHtml = `<!DOCTYPE html><html><head><meta charset=\"utf-8\">\n<title>ChatApp Daily Digest</title>\n<style>body{font-family:system-ui,sans-serif;max-width:720px;margin:2rem auto;padding:0 1rem;line-height:1.5}\nh1{font-size:1.4rem}h2{font-size:1.1rem;margin-top:2rem}li{margin-bottom:1rem}</style>\n</head><body>\n<h1>ChatApp Daily Digest</h1>\n<p><em>Generated ${escapeHtml(publishedAt)}</em></p>\n<h2>Overall (last 24h)</h2><p>${escapeHtml(overallSummary)}</p>\n<h2>Per-conversation summaries</h2><ul>${rowsHtml || '<li>(no active conversations)</li>'}</ul>\n</body></html>`;\n\nreturn { json: { digestText, digestHtml, publishedAt, threadSummaries, overallSummary } };"
      },
