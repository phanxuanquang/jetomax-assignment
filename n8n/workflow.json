    {
      "parameters": {
        "jsCode": "let overallSummary = null;\ntry {\n  const raw = $json.data !== undefined ? $json.data : $json;\n  overallSummary = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  overallSummary = null;\n}\nif (!overallSummary || typeof overallSummary !== 'string') {\n  overallSummary = '[Overall 24h summary unavailable — the roll-up call failed.]';\n}\nreturn { json: { overallSummary } };"
      },
      "id": "5f759018-2d09-488a-ab71-83dba60bdc68",
      "name": "Parse Rollup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
