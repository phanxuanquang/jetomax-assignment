    {
      "parameters": {
        "jsCode": "// Each item here corresponds 1:1 to the same-index item from \"Get All Conversations\" (n8n item-linking), so we can read the\n// original conversationId/displayName back via $('...').item.\nconst source = $('Get All Conversations').item.json;\nlet summary = null;\ntry {\n  const raw = $json.data !== undefined ? $json.data : $json;\n  summary = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  summary = null;\n}\nif (!summary || typeof summary !== 'string') {\n  summary = '[Summary unavailable for this thread — the AI call failed or returned an unexpected shape.]';\n}\nreturn { json: {\n  conversationId: source.conversationId,\n  displayName: source.displayName,\n  summary,\n} };"
      },
