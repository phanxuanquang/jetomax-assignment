# Backend secrets, read by start-dev.ps1 and written into `dotnet user-secrets`.
# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.
# What each key means and where to get it: ./README.md#environment-variables-reference
#
# Format: one KEY=VALUE per line, no quotes. KEY becomes the exact `dotnet user-secrets` key
# (colon-delimited, e.g. Supabase:Url), so keep the colons as-is.

# Supabase project URL — bound into two separate config sections (JWT validation, storage client).
# Already defaulted in appsettings.json to the demo project used elsewhere in this repo; only set
# these if you're pointing at your own project (set both, same value).
# Supabase:Url=https://your-project-ref.supabase.co
# SupabaseStorageOptions:Url=https://your-project-ref.supabase.co

# Service-role key (Project Settings -> API). Must bypass RLS — see docs/database-design.md#row-level-security.
SupabaseStorageOptions:ServiceRoleKey=

# Private Storage bucket for images. Already defaulted in appsettings.json; only set here if you use a different name.
# SupabaseStorageOptions:StorageBucket=images

# Postgres connection string (Project Settings -> Database -> Connection string -> "Session Pooler" for hosted
# projects, or `supabase status` for local). NOT the same credential as ServiceRoleKey — see README.md#configure--run.
ConnectionStrings:Postgres=

# Google AI Studio key: https://aistudio.google.com/apikey
GeminiConnectionOptions:ApiKey=

# Model id — already defaulted in appsettings.json; only set here to override.
# GeminiConnectionOptions:ModelId=gemini-3.1-flash-lite

# Random secrets you invent yourself — share the value (never the command) with whoever runs mcp/ or n8n/.
Clients:McpKey=
Clients:N8nKey=

# Tokens accumulated before a conversation's next chunk is summarized and folded. Already defaulted
# in appsettings.json (1500); only set here to override.
# ConversationMemoryOptions:TokenThreshold=1500
