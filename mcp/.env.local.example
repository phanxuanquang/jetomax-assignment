# MCP server secrets, read by start-dev.ps1 and written into `dotnet user-secrets`.
# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.
# Full setup (Supabase OAuth Server, dynamic client registration): ../mcp/README.md#setup

# The running backend's URL.
Backend:BaseUrl=http://localhost:5000

# Must equal the backend's own Clients:McpKey (see ../backend/.env.local).
Backend:ClientKey=

# An existing User-role backend account — every tool call acts on behalf of this one account.
Backend:OnBehalfOfUsername=

# Supabase project API URL, e.g. https://xxxxx.supabase.co (no trailing slash). Same project the
# backend already uses for its own Supabase JWT (see ../backend/.env.local's Supabase:Url).
Supabase:Url=

# Stable identifier for this MCP server as an RFC 9728 protected resource. Any fixed string —
# doesn't need to be reachable or match this server's real host.
Supabase:ResourceUri=
